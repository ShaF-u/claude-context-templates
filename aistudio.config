# context-reduction-core が --mcp で起動する際の設定。
# 詳細は README.md「Core（MCPサーバー）」/ bench/README.md 参照。

# 索引・検索から除外するパス(DefaultIgnorePatterns に追加される)。
# bench/results の測定結果JSONはタスクのintent文をそのまま含むため、
# 「質問文が書かれているだけのファイル」が検索に引っかかっていた。
scan.extra_ignore_patterns=bench/results,bench/tasks.json

# context_retrieve のレスポンス予算（トークン、chars/4推定）。
# 未設定(0)は無予算 — 全マッチが無圧縮でそのまま返る。実測(bench/results/,
# 2026-09-18)で、無予算だとnaive(Read/Grep)より多くのトークンを消費した。
# 予算を切ると、ContextSelector/ContextCompressor（元から実装済み・オプトイン
# なだけだった機能）が有効になり、収まらない項目は "omitted" にidだけ残る
# (context_fetch で個別取得できる)。3000 = 上位数件の関数本体が丸ごと入る量。
mcp.context_response_budget_tokens=8000

# tools/list に出すツールを絞る。未設定は全ツール(15個)。
# 実測(2026-09-18)で、15個あるとモデルが1つの質問を5種類のツールに分散して
# ターン数が増え(毎ターン会話全体を再送するので累積トークンが膨らむ)、
# context_retrieve 単独で済む質問でも naive より高くついた。
# keyword_search は grep 相当。外すと「Xはどこで使われているか」型の質問で、
# モデルが context_retrieve + context_fetch の範囲当てで grep を模倣し、
# 1質問に20回呼ぶことがあった(2026-09-22 security-sandbox: naiveの2.5倍)。
mcp.tools=context_retrieve,context_fetch,symbol_search,keyword_search

# 予算付き context_retrieve の応答をJSONではなくテキストで返す。同じ内容で
# 約1/3小さい(項目ごとのフィールド名とコードのJSONエスケープが無くなる)。
mcp.context_retrieve_format=text

# 同一セッションで既に送った項目は、2回目以降の context_retrieve では
# 本文を送らずスタブにする(実装済み・オプトイン)。実測でモデルはintentを
# 変えて2回呼ぶことが多く、その2回目の大半が重複だった。
mcp.suppress_resent_content=true

# ProjectRulesBackend が context_retrieve に CLAUDE.md 全文を毎回混ぜるのを止める。
# Claude Code は CLAUDE.md をセッション開始時に自動で読んでいるので純粋な重複
# (実測で1回あたり約560トークン)。空にすると項目自体が出なくなる。
backend.core.project_rules.files=
